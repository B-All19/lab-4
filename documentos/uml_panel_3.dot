digraph G {
graph [rankdir=TB bgcolor="white" nodesep=0.4 ranksep=0.8 pad=0.3 label="Eventos y resultados" labelloc=t fontsize=26 fontname="DejaVu Sans"];
node [shape=plain fontname="DejaVu Sans" fontsize=12];
edge [fontname="DejaVu Sans" fontsize=10 arrowsize=1.0 labeldistance=2.1];
"Evento" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>«interface»<BR/>Evento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getFicha(): FichaEvento {abstract}</I><BR ALIGN="LEFT"/><I>+ evaluar(datos: DatosResultado): Map&lt;String, Aporte&gt; {abstract}</I><BR ALIGN="LEFT"/><I>+ leerResultado(entrada: Entrada): DatosResultado {abstract}</I><BR ALIGN="LEFT"/>+ compareTo(otro: Evento): int {override} {default}</TD></TR></TABLE>>];
"FichaEvento" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>FichaEvento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigo: String<BR ALIGN="LEFT"/>- participantes: List&lt;Participante&gt;<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/>- hora: int<BR ALIGN="LEFT"/>- sede: String<BR ALIGN="LEFT"/>- aportes: Map&lt;String, Aporte&gt;<BR ALIGN="LEFT"/>- resultado: DatosResultado</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ FichaEvento(codigo: String, participantes: List&lt;Participante&gt;) «create»<BR ALIGN="LEFT"/>+ getCodigo(): String<BR ALIGN="LEFT"/>+ getParticipantes(): List&lt;Participante&gt;<BR ALIGN="LEFT"/>+ getFecha(): LocalDate<BR ALIGN="LEFT"/>+ getHora(): int<BR ALIGN="LEFT"/>+ getSede(): String<BR ALIGN="LEFT"/>+ getResultado(): DatosResultado<BR ALIGN="LEFT"/>+ getAportes(): Map&lt;String, Aporte&gt;<BR ALIGN="LEFT"/>+ getEstado(): EstadoEvento<BR ALIGN="LEFT"/>~ programar(fecha: LocalDate, hora: int, sede: String): void<BR ALIGN="LEFT"/>~ confirmar(datos: DatosResultado, aportes: Map&lt;String, Aporte&gt;): void</TD></TR></TABLE>>];
"Encuentro" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Encuentro</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ficha: FichaEvento<BR ALIGN="LEFT"/>- disciplina: DisciplinaEncuentro</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Encuentro(codigo: String, disciplina: DisciplinaEncuentro, local: Participante,<BR ALIGN="LEFT"/>    visitante: Participante) «create»<BR ALIGN="LEFT"/>+ getFicha(): FichaEvento {override}<BR ALIGN="LEFT"/>+ evaluar(datos: DatosResultado): Map&lt;String, Aporte&gt; {override}<BR ALIGN="LEFT"/>+ leerResultado(entrada: Entrada): DatosResultado {override}</TD></TR></TABLE>>];
"Carrera" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Carrera</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ficha: FichaEvento<BR ALIGN="LEFT"/>- disciplina: Disciplina</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Carrera(codigo: String, disciplina: Disciplina, participantes: List&lt;Participante&gt;) «create»<BR ALIGN="LEFT"/>+ getFicha(): FichaEvento {override}<BR ALIGN="LEFT"/>+ evaluar(datos: DatosResultado): Map&lt;String, Aporte&gt; {override}<BR ALIGN="LEFT"/>+ leerResultado(entrada: Entrada): DatosResultado {override}</TD></TR></TABLE>>];
"DatosResultado" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>DatosResultado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- valores: Map&lt;String, BigDecimal&gt;<BR ALIGN="LEFT"/>- penales: Map&lt;String, Integer&gt;<BR ALIGN="LEFT"/>- descalificados: Set&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ DatosResultado(valores: Map&lt;String, BigDecimal&gt;, penales: Map&lt;String, Integer&gt;,<BR ALIGN="LEFT"/>    descalificados: Set&lt;String&gt;) «create»<BR ALIGN="LEFT"/>+ getValores(): Map&lt;String, BigDecimal&gt;<BR ALIGN="LEFT"/>+ getPenales(): Map&lt;String, Integer&gt;<BR ALIGN="LEFT"/>+ getDescalificados(): Set&lt;String&gt;</TD></TR></TABLE>>];
"Aporte" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Aporte</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- puntos: int<BR ALIGN="LEFT"/>- diferencia: long<BR ALIGN="LEFT"/>- victorias: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Aporte(puntos: int, diferencia: long, victorias: int) «create»<BR ALIGN="LEFT"/>+ getPuntos(): int<BR ALIGN="LEFT"/>+ getDiferencia(): long<BR ALIGN="LEFT"/>+ getVictorias(): int</TD></TR></TABLE>>];
"Participante" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Participante<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"Disciplina" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Disciplina<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"DisciplinaEncuentro" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">DisciplinaEncuentro<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"Encuentro" -> "Evento" [arrowhead=empty style=dashed];
"Carrera" -> "Evento" [arrowhead=empty style=dashed];
"Encuentro" -> "FichaEvento" [dir=both arrowtail=diamond arrowhead=none taillabel="1" headlabel="1" label="estado"];
"Carrera" -> "FichaEvento" [dir=both arrowtail=diamond arrowhead=none taillabel="1" headlabel="1" label="estado"];
"Encuentro" -> "DisciplinaEncuentro" [dir=both arrowtail=none arrowhead=none taillabel="0..*" headlabel="1" label="reglas"];
"Carrera" -> "Disciplina" [dir=both arrowtail=none arrowhead=none taillabel="0..*" headlabel="1" label="reglas"];
"FichaEvento" -> "Participante" [dir=both arrowtail=none arrowhead=none taillabel="0..*" headlabel="1..8" label="participantes"];
"FichaEvento" -> "DatosResultado" [dir=both arrowtail=diamond arrowhead=none taillabel="1" headlabel="0..1" label="resultado"];
"FichaEvento" -> "Aporte" [dir=both arrowtail=diamond arrowhead=none taillabel="1" headlabel="0..8" label="por participante"];
CO [label="«interface»
Comparable<Evento>" shape=box];
"Evento" -> "CO" [arrowhead=empty style=solid];
"Evento" -> "FichaEvento" [style=dashed arrowhead=vee label="consulta"];
nota [shape=note label="Encuentro y Carrera no comparten superclase. Componen una FichaEvento y realizan la interfaz Evento.\ncompareTo usa fecha, hora y sede. Un encuentro contiene exactamente 2 participantes y una carrera de relevos de 3 a 8." fontsize=12];
}