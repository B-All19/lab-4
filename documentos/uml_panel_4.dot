digraph G {
graph [rankdir=TB bgcolor="white" nodesep=0.4 ranksep=0.8 pad=0.3 label="Consola, carga inicial y pruebas" labelloc=t fontsize=26 fontname="DejaVu Sans"];
node [shape=plain fontname="DejaVu Sans" fontsize=12];
edge [fontname="DejaVu Sans" fontsize=10 arrowsize=1.0 labeldistance=2.1];
"Main" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- app: ArenaGT<BR ALIGN="LEFT"/>- entrada: Entrada</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Main(app: ArenaGT, entrada: Entrada) «create»<BR ALIGN="LEFT"/><U>+ main(args: String[]): void</U><BR ALIGN="LEFT"/>+ ejecutar(): void<BR ALIGN="LEFT"/>- seleccionarDisciplina(): Disciplina<BR ALIGN="LEFT"/>- programar(): void<BR ALIGN="LEFT"/>- mostrarTorneos(): void<BR ALIGN="LEFT"/>- mostrarCalendario(): void<BR ALIGN="LEFT"/>- mostrarEvento(evento: Evento): void<BR ALIGN="LEFT"/>- mostrarTabla(): void<BR ALIGN="LEFT"/>- mostrarFinanzas(): void<BR ALIGN="LEFT"/><U>- dinero(valor: BigDecimal): String</U></TD></TR></TABLE>>];
"Entrada" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Entrada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- scanner: Scanner</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Entrada(scanner: Scanner) «create»<BR ALIGN="LEFT"/>+ texto(mensaje: String): String<BR ALIGN="LEFT"/>+ entero(mensaje: String): int<BR ALIGN="LEFT"/>+ fecha(mensaje: String): LocalDate</TD></TR></TABLE>>];
"DatosIniciales" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>DatosIniciales</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- DatosIniciales() «create»<BR ALIGN="LEFT"/><U>+ crear(): ArenaGT</U><BR ALIGN="LEFT"/><U>- partido(app: ArenaGT, torneo: String, a: String, b: String, x: int, y: int, pa: Integer,<BR ALIGN="LEFT"/>    pb: Integer): void</U></TD></TR></TABLE>>];
"Validacion" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Validacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- Validacion() «create»<BR ALIGN="LEFT"/><U>+ exigir(condicion: boolean, mensaje: String): void</U><BR ALIGN="LEFT"/><U>+ texto(valor: String, campo: String): String</U><BR ALIGN="LEFT"/><U>+ clave(valor: String): String</U></TD></TR></TABLE>>];
"Pruebas" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Pruebas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- verificadas: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- Pruebas() «create»<BR ALIGN="LEFT"/><U>+ main(args: String[]): void</U><BR ALIGN="LEFT"/><U>- comprobar(caso: String, entrada: String, esperado: Object, obtenido: Object): void</U><BR ALIGN="LEFT"/><U>- marcador(a: String, b: String, x: int, y: int): DatosResultado</U><BR ALIGN="LEFT"/><U>- resumen(aportes: Map&lt;String, Aporte&gt;): String</U><BR ALIGN="LEFT"/><U>- base(cantidad: int): ArenaGT</U><BR ALIGN="LEFT"/><U>- foto(a: ArenaGT): String</U><BR ALIGN="LEFT"/><U>- rechazar(caso: String, entrada: String, a: ArenaGT, operacion: Runnable): void</U><BR ALIGN="LEFT"/><U>- reglas(): void</U><BR ALIGN="LEFT"/><U>- finanzas(): void</U><BR ALIGN="LEFT"/><U>- rechazos(): void</U><BR ALIGN="LEFT"/><U>- calendarios(): void</U><BR ALIGN="LEFT"/><U>- codigos(calendario: Calendario): String</U><BR ALIGN="LEFT"/><U>- ordenes(): void</U><BR ALIGN="LEFT"/><U>- consola(): void</U></TD></TR></TABLE>>];
"EstadoEvento" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>«enumeration»<BR/>EstadoEvento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SIN_PROGRAMAR, PROGRAMADO, FINALIZADO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"EstadoTorneo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>«enumeration»<BR/>EstadoTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">INSCRIPCION, EN_JUEGO, FINALIZADO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ArenaGT" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">ArenaGT<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"FichaEvento" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">FichaEvento<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"Torneo" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Torneo<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"Main" -> "ArenaGT" [dir=both arrowtail=none arrowhead=none taillabel="1" headlabel="1" label="servicio"];
"Main" -> "Entrada" [dir=both arrowtail=none arrowhead=none taillabel="1" headlabel="1" label="lectura"];
"Main" -> "DatosIniciales" [style=dashed arrowhead=vee label="inicializa"];
"DatosIniciales" -> "ArenaGT" [style=dashed arrowhead=vee label="carga sin cobros"];
"Pruebas" -> "Main" [style=dashed arrowhead=vee label="prueba menú"];
"Pruebas" -> "ArenaGT" [style=dashed arrowhead=vee label="verifica"];
"FichaEvento" -> "EstadoEvento" [style=dashed arrowhead=vee label="deriva"];
"Torneo" -> "EstadoTorneo" [style=dashed arrowhead=vee label="deriva"];
"ArenaGT" -> "Validacion" [style=dashed arrowhead=vee label="valida"];
nota [shape=note label="Main contiene el punto de entrada y Pruebas ofrece un segundo main para validación automática.\nEl último resultado finaliza el torneo automáticamente. Los premios ya existentes en la precarga no se contabilizan como pagos." fontsize=12];
}