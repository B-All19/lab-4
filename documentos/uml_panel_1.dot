digraph G {
graph [rankdir=TB bgcolor="white" nodesep=0.4 ranksep=0.8 pad=0.3 label="Dominio, reportes y coordinación" labelloc=t fontsize=26 fontname="DejaVu Sans"];
node [shape=plain fontname="DejaVu Sans" fontsize=12];
edge [fontname="DejaVu Sans" fontsize=10 arrowsize=1.0 labeldistance=2.1];
"ArenaGT" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>ArenaGT</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- participantes: Map&lt;String, Participante&gt;<BR ALIGN="LEFT"/>- torneos: Map&lt;String, Torneo&gt;<BR ALIGN="LEFT"/>- disciplinas: Map&lt;String, Disciplina&gt;<BR ALIGN="LEFT"/>- ingresos: Map&lt;String, BigDecimal&gt;<BR ALIGN="LEFT"/>- premiosIniciales: Set&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ArenaGT() «create»<BR ALIGN="LEFT"/>+ getDisciplinas(): List&lt;Disciplina&gt;<BR ALIGN="LEFT"/>+ getParticipantes(): List&lt;Participante&gt;<BR ALIGN="LEFT"/>+ getTorneos(): List&lt;Torneo&gt;<BR ALIGN="LEFT"/>+ participante(codigo: String): Participante<BR ALIGN="LEFT"/>+ torneo(codigo: String): Torneo<BR ALIGN="LEFT"/>+ registrarParticipante(codigo: String, nombre: String, empresa: String): void<BR ALIGN="LEFT"/>+ crearTorneo(codigo: String, nombre: String, disciplina: Disciplina): Torneo<BR ALIGN="LEFT"/>- crear(codigo: String, nombre: String, disciplina: Disciplina, demo: boolean): Torneo<BR ALIGN="LEFT"/>~ cargarTorneo(codigo: String, nombre: String, disciplina: Disciplina, codigos: List&lt;String&gt;): Torneo<BR ALIGN="LEFT"/>+ inscribir(torneo: String, participante: String): void<BR ALIGN="LEFT"/>+ cerrarInscripciones(codigo: String): void<BR ALIGN="LEFT"/>+ eventos(): List&lt;Evento&gt;<BR ALIGN="LEFT"/>+ evento(codigo: String): Evento<BR ALIGN="LEFT"/>+ programar(codigo: String, fecha: LocalDate, hora: int, sede: String): void<BR ALIGN="LEFT"/>+ registrarResultado(codigo: String, datos: DatosResultado): void<BR ALIGN="LEFT"/>+ calendarioGeneral(): Calendario<BR ALIGN="LEFT"/>+ calendarioTorneo(codigo: String): Calendario<BR ALIGN="LEFT"/>+ calendarioParticipante(codigo: String): Calendario<BR ALIGN="LEFT"/>+ ingresosPorDisciplina(): Map&lt;String, BigDecimal&gt;<BR ALIGN="LEFT"/>+ ingresosTotales(): BigDecimal<BR ALIGN="LEFT"/>~ cerrarCargaInicial(): void<BR ALIGN="LEFT"/>+ esPremioInicial(codigo: String): boolean<BR ALIGN="LEFT"/>+ premiosEntregados(): BigDecimal<BR ALIGN="LEFT"/>+ rankingEmpresas(): List&lt;FilaEmpresa&gt;</TD></TR></TABLE>>];
"Torneo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Torneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigo: String<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- disciplina: Disciplina<BR ALIGN="LEFT"/>- demostracion: boolean<BR ALIGN="LEFT"/>- participantes: List&lt;Participante&gt;<BR ALIGN="LEFT"/>- eventos: List&lt;Evento&gt;<BR ALIGN="LEFT"/>- cerrado: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Torneo(codigo: String, nombre: String, disciplina: Disciplina, demostracion: boolean) «create»<BR ALIGN="LEFT"/>+ getCodigo(): String<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getDisciplina(): Disciplina<BR ALIGN="LEFT"/>+ isDemostracion(): boolean<BR ALIGN="LEFT"/>+ getParticipantes(): List&lt;Participante&gt;<BR ALIGN="LEFT"/>+ getEventos(): List&lt;Evento&gt;<BR ALIGN="LEFT"/>+ getEstado(): EstadoTorneo<BR ALIGN="LEFT"/>~ agregar(participante: Participante): void<BR ALIGN="LEFT"/>~ cerrar(): void<BR ALIGN="LEFT"/>+ tabla(): List&lt;FilaTabla&gt;<BR ALIGN="LEFT"/>+ campeon(): Participante<BR ALIGN="LEFT"/>+ premio(): BigDecimal</TD></TR></TABLE>>];
"Participante" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Participante</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigo: String<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- empresa: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Participante(codigo: String, nombre: String, empresa: String) «create»<BR ALIGN="LEFT"/>+ getCodigo(): String<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getEmpresa(): String<BR ALIGN="LEFT"/>+ toString(): String {override}</TD></TR></TABLE>>];
"FilaTabla" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>FilaTabla</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- participante: Participante<BR ALIGN="LEFT"/>- puntos: int<BR ALIGN="LEFT"/>- diferencia: long<BR ALIGN="LEFT"/>- victorias: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ FilaTabla(participante: Participante, puntos: int, diferencia: long, victorias: int) «create»<BR ALIGN="LEFT"/>+ getParticipante(): Participante<BR ALIGN="LEFT"/>+ getPuntos(): int<BR ALIGN="LEFT"/>+ getDiferencia(): long<BR ALIGN="LEFT"/>+ getVictorias(): int<BR ALIGN="LEFT"/>+ compareTo(otra: FilaTabla): int {override}<BR ALIGN="LEFT"/>+ toString(): String {override}</TD></TR></TABLE>>];
"FilaEmpresa" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>FilaEmpresa</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- empresa: String<BR ALIGN="LEFT"/>- puntos: long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ FilaEmpresa(empresa: String, puntos: long) «create»<BR ALIGN="LEFT"/>+ getEmpresa(): String<BR ALIGN="LEFT"/>+ getPuntos(): long<BR ALIGN="LEFT"/>+ compareTo(otra: FilaEmpresa): int {override}<BR ALIGN="LEFT"/>+ toString(): String {override}</TD></TR></TABLE>>];
"Calendario" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Calendario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- eventos: List&lt;Evento&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Calendario(origen: Collection&lt;Evento&gt;) «create»<BR ALIGN="LEFT"/>+ iterator(): Iterator&lt;Evento&gt; {override}<BR ALIGN="LEFT"/>+ size(): int</TD></TR></TABLE>>];
"Disciplina" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Disciplina<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"Evento" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Evento<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"ArenaGT" -> "Torneo" [dir=both arrowtail=diamond arrowhead=none taillabel="1" headlabel="0..*" label="administra"];
"ArenaGT" -> "Participante" [dir=both headport=w arrowtail=diamond arrowhead=none taillabel="1" headlabel="0..*" label="registra"];
"ArenaGT" -> "Disciplina" [dir=both arrowtail=none arrowhead=none taillabel="1" headlabel="5..*" label="catálogo"];
"Torneo" -> "Participante" [dir=both arrowtail=none arrowhead=none taillabel="0..*" headlabel="0..8" label="inscritos"];
"Torneo" -> "Disciplina" [dir=both arrowtail=none arrowhead=none taillabel="0..*" headlabel="1" label="reglas"];
"Torneo" -> "Evento" [dir=both arrowtail=diamond arrowhead=none taillabel="1" headlabel="0..28" label="eventos"];
"Calendario" -> "Evento" [dir=both arrowtail=none arrowhead=none taillabel="0..*" headlabel="0..*" label="referencias"];
"FilaTabla" -> "Participante" [dir=both arrowtail=none arrowhead=none taillabel="0..*" headlabel="1" label="identifica"];
"ArenaGT" -> "FilaEmpresa" [style=dashed arrowhead=vee label="calcula"];
"Torneo" -> "FilaTabla" [style=dashed arrowhead=vee label="calcula"];
"ArenaGT" -> "Calendario" [style=dashed arrowhead=vee label="crea"];
CF [label="«interface»
Comparable<FilaTabla>" shape=box];
CE [label="«interface»
Comparable<FilaEmpresa>" shape=box];
IT [label="«interface»
Iterable<Evento>" shape=box];
"FilaTabla" -> "CF" [arrowhead=empty style=dashed];
"FilaEmpresa" -> "CE" [arrowhead=empty style=dashed];
"Calendario" -> "IT" [arrowhead=empty style=dashed];
nota [shape=note label="Los puntajes se calculan desde aportes inmutables. FilaTabla ordena por puntos, diferencia, victorias y nombre.\nCalendario renueva el orden en iterator. ArenaGT controla conflictos globales y confirma resultados." fontsize=12];
}