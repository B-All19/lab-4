digraph G {
graph [rankdir=TB bgcolor="white" nodesep=0.4 ranksep=0.8 pad=0.3 label="Jerarquía de disciplinas" labelloc=t fontsize=26 fontname="DejaVu Sans"];
node [shape=plain fontname="DejaVu Sans" fontsize=12];
edge [fontname="DejaVu Sans" fontsize=10 arrowsize=1.0 labeldistance=2.1];
"Disciplina" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B><I>Disciplina</I><BR/>«abstract»</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- minimo: int<BR ALIGN="LEFT"/>- maximo: int<BR ALIGN="LEFT"/>- cuota: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># Disciplina(nombre: String, minimo: int, maximo: int, cuota: BigDecimal) «create»<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getMinimo(): int<BR ALIGN="LEFT"/>+ getMaximo(): int<BR ALIGN="LEFT"/>+ getCuota(): BigDecimal<BR ALIGN="LEFT"/>+ cotizar(cantidad: int): BigDecimal<BR ALIGN="LEFT"/>+ validarInscripcion(inscritos: List&lt;Participante&gt;, nuevo: Participante): void<BR ALIGN="LEFT"/><I>+ crearEventos(torneo: String, participantes: List&lt;Participante&gt;): List&lt;Evento&gt; {abstract}</I><BR ALIGN="LEFT"/><I>+ evaluar(participantes: List&lt;Participante&gt;, datos: DatosResultado): Map&lt;String, Aporte&gt; {abstract}</I><BR ALIGN="LEFT"/><I>+ leerResultado(entrada: Entrada, participantes: List&lt;Participante&gt;): DatosResultado {abstract}</I></TD></TR></TABLE>>];
"DisciplinaEncuentro" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B><I>DisciplinaEncuentro</I><BR/>«abstract»</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># DisciplinaEncuentro(nombre: String, minimo: int, maximo: int, cuota: BigDecimal) «create»<BR ALIGN="LEFT"/>+ crearEventos(torneo: String, participantes: List&lt;Participante&gt;): List&lt;Evento&gt; {override}<BR ALIGN="LEFT"/># marcadores(participantes: List&lt;Participante&gt;, datos: DatosResultado): int[]<BR ALIGN="LEFT"/># aportes(ps: List&lt;Participante&gt;, a: int, b: int, puntosA: int, puntosB: int,<BR ALIGN="LEFT"/>    ganador: int): Map&lt;String, Aporte&gt;<BR ALIGN="LEFT"/>+ leerResultado(entrada: Entrada, participantes: List&lt;Participante&gt;): DatosResultado {override}</TD></TR></TABLE>>];
"FutbolSala" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>FutbolSala</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ FutbolSala() «create»<BR ALIGN="LEFT"/># FutbolSala(nombre: String, cuota: BigDecimal) «create»<BR ALIGN="LEFT"/>+ evaluar(ps: List&lt;Participante&gt;, datos: DatosResultado): Map&lt;String, Aporte&gt; {override}</TD></TR></TABLE>>];
"FutbolSalaPenales" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>FutbolSalaPenales</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ FutbolSalaPenales() «create»<BR ALIGN="LEFT"/>+ evaluar(ps: List&lt;Participante&gt;, datos: DatosResultado): Map&lt;String, Aporte&gt; {override}<BR ALIGN="LEFT"/>+ leerResultado(entrada: Entrada, ps: List&lt;Participante&gt;): DatosResultado {override}</TD></TR></TABLE>>];
"Baloncesto" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Baloncesto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Baloncesto() «create»<BR ALIGN="LEFT"/>+ evaluar(ps: List&lt;Participante&gt;, datos: DatosResultado): Map&lt;String, Aporte&gt; {override}</TD></TR></TABLE>>];
"Voleibol" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Voleibol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Voleibol() «create»<BR ALIGN="LEFT"/>+ evaluar(ps: List&lt;Participante&gt;, datos: DatosResultado): Map&lt;String, Aporte&gt; {override}</TD></TR></TABLE>>];
"Relevos" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dae6ee"><B>Relevos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- PUNTOS: int[]</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Relevos() «create»<BR ALIGN="LEFT"/>+ crearEventos(torneo: String, ps: List&lt;Participante&gt;): List&lt;Evento&gt; {override}<BR ALIGN="LEFT"/>+ evaluar(ps: List&lt;Participante&gt;, datos: DatosResultado): Map&lt;String, Aporte&gt; {override}<BR ALIGN="LEFT"/>+ leerResultado(entrada: Entrada, ps: List&lt;Participante&gt;): DatosResultado {override}</TD></TR></TABLE>>];
"Evento" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Evento<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"DatosResultado" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">DatosResultado<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"Aporte" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Aporte<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"Entrada" [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f5">Entrada<BR/><FONT POINT-SIZE="10">Referencia a otro panel</FONT></TD></TR></TABLE> >];
"DisciplinaEncuentro" -> "Disciplina" [arrowhead=empty style=solid];
"Relevos" -> "Disciplina" [arrowhead=empty style=solid];
"FutbolSala" -> "DisciplinaEncuentro" [arrowhead=empty style=solid];
"FutbolSalaPenales" -> "FutbolSala" [arrowhead=empty style=solid];
"Baloncesto" -> "DisciplinaEncuentro" [arrowhead=empty style=solid];
"Voleibol" -> "DisciplinaEncuentro" [arrowhead=empty style=solid];
"Disciplina" -> "Evento" [style=dashed arrowhead=vee label="crea"];
"Disciplina" -> "DatosResultado" [style=dashed arrowhead=vee label="valida"];
"Disciplina" -> "Aporte" [style=dashed arrowhead=vee label="calcula"];
"Disciplina" -> "Entrada" [style=dashed arrowhead=vee label="lee"];
nota [shape=note label="Cada evaluar aplica las reglas de la disciplina sin modificar tablas. FutbolSalaPenales reutiliza el resultado reglamentario.\nLa cuota y los límites se inicializan con super. validarInscripcion es sobrescribible para nuevas reglas." fontsize=12];
}